# ============================================================================
# Personal Voice Replication & Gemini 3.8 TTS Configuration
# ============================================================================

# Gemini Developer API Key provisioned inside your target GCP project.
# Stateful voices (`store=True`) are stored in the project associated with this key.
GEMINI_API_KEY="your-gemini-api-key-here"

# Google Cloud Project ID for GCS backup and project-level security checks
GCP_PROJECT_ID="<your-project>"

# Regional GCS bucket for backing up master 24kHz WAV clips (COLDLINE) and voices.json (STANDARD)
GCS_BUCKET_NAME="<voice-name>-voice-replication"
GCS_LOCATION="europe-west2"
GCS_DEFAULT_STORAGE_CLASS="COLDLINE"

# Default TTS & Transcription Models (NEVER downgrade)
DEFAULT_TTS_MODEL="gemini-3.8-flash-tts"
FAST_TTS_MODEL="gemini-3.8-flash-lite-tts"
TRANSCRIBE_MODEL="gemini-3.5-transcribe"

# Default Voice Alias & Local Data Paths
DEFAULT_VOICE_ALIAS="<voice-name>"
DATA_DIR="data"
OUTPUT_DIR="output"
